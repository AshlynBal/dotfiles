{
    "height": 33, // Waybar height (to be removed for auto height)
    "spacing": 8, // Gaps between modules (4px)
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "wlr/taskbar"
        // "custom/power"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "custom/music",
        "network",
        //"custom/network",
        "bluetooth",
        "custom/battery",
        //"battery",
        "clock",
        "custom/notification"
    ],
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    /* === Modules Left === */

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "gaming": "󰮂 ",
            "discord": " ",
            "obsidian": "󰠮"
        }
    },


    /* === Modules Center === */

    "wlr/taskbar": {
        "format": "{icon}",
        "all-outputs": false,
        "active-first": false,
        "tooltip-format": "{name}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "rofi"
        ]
    },

    "custom/power": {
    "format" : "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate",
        },
    },

    /* === Modules Right === */

    "tray": {
        //"icon-size": 21,
        "spacing": 10
    },
    // waybar-module-music
    "custom/music": {
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "{}",
        "return-type": "json",
        "exec": "waybar-module-music --format \"🎵 %artist% | %title%\" --marquee --title-width 25"
    },

    "clock": {
        "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %b %d   %R}"
//        "format": "{:%a %b %d %I:%M %p}"
    },
    "custom/notification": {
        "format": "󰂚",
        "on-click": "swaync-client -t -sw",
        "tooltip": "false",
        // 󱅫
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery_state.sh",
        "return-type": "json",
        "interval": 10,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menus/power_profile_menu.xml",
        "menu-actions": {
            "performance": "powerprofilesctl set performance",
            "balanced": "powerprofilesctl set balanced",
            "power-saver": "powerprofilesctl set power-saver"
        }
    },
    "battery": {
        "format": "{icon} {capacity}%",
        //"format-charging": "󰂄",
        "format-charging": "{icon}󱐋 {capacity}%",
        "format-plugged": "",
        //"format-alt": "{icon} {capacity}%",
        "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip": true,
        "tooltip-format": "{capacity}% - {timeTo}"

    },
    "network": {
        "format-wifi": "{icon}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {icon} ",
        "format-ethernet": "{icon}󰈁",
        "tooltip-format-ethernet": "{ipaddr}/{cidr} {icon}󰈁",
        "format-disconnected": "Disconnected ⚠",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menus/wifi_menu.xml",
        "menu-actions": {
            "disconnect": "nmcli device disconnect wlan0",
            "avalible-networks": "~/.config/waybar/scripts/rofi-wifi-menu.sh",
            "edit-connections": "hyprctl dispatch exec \"[float on] nm-connection-editor\"",
            "nmtui": "hyprctl dispatch exec \"[float on] kitty -e nmtui\""
        }
    },
//    "custom/network": {
//        "exec": "~/.config/waybar/scripts/wifi-location.sh",
//        "return-type": "json",
//        "interval": 5,
//        "format": "{}",
//        "tooltip": true,
//        // "on-click": "nm-connection-editor",
//        // "on-click-right": "kitty -e nmtui",
//        "menu": "on-click",
//        "menu-file": "~/.config/waybar/menus/wifi_menu.xml",
//        "menu-actions": {
//            "disconnect": "nmcli device disconnect wlan0",
//            "avalible-networks": "~/.config/waybar/scripts/rofi-wifi-menu.sh",
//            "edit-connections": "nm-connection-editor",
//            "nmtui": "kitty -e nmtui"
//        }
//        "on-scroll-up": "nmcli radio wifi on",
//        "on-scroll-down": "nmcli radio wifi off"
//    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Connected to {device_alias}",
        "tooltip-format-connected-battery": "Connected to {device_alias} ({device_battery_percentage}%)",
        "on-click": "blueman-manager",
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}%",
        "format-bluetooth": "{volume}%",
        "format-bluetooth-muted": "󰝟 ",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}

