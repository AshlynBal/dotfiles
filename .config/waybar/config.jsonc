{
    "height": 33, // Waybar height (to be removed for auto height)
    "spacing": 8, // Gaps between modules (4px)
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "wlr/taskbar",
        "custom/power"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
      //  "network",
        "custom/network",
        "bluetooth",
        "battery",
        "clock",
        "custom/notification"
    ],
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "tray": {
        //"icon-size": 21,
        "spacing": 10
    },
    /* === Modules Left === */

    /* === Modules Center === */

    "wlr/taskbar": {
        "format": "{icon}",
        "all-outputs": false,
        "active-first": false,
        "tooltip-format": "{name}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "rofi"
        ]
    },

    "custom/power": {
    "format" : "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate",
        },
    },

    /* === Modules Right === */

    "clock": {
        "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %b %d   %R}"
//        "format": "{:%a %b %d %I:%M %p}"
    },
    "custom/notification": {
        "format": "󰂚",
        "on-click": "swaync-client -t -sw",
        "tooltip": "false",
        // 󱅫
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "format": "{icon} {capacity}%",
        //"format-charging": "󰂄",
        "format-charging": "{icon}󱐋 {capacity}%",
        "format-plugged": "",
        //"format-alt": "{icon} {capacity}%",
        "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip": true,
        "tooltip-format": "{capacity}% - {timeTo}"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "on-click": "~/.config/waybar/scripts/rofi-wifi-menu.sh"
    },
    "custom/network": {
        "exec": "~/.config/waybar/scripts/wifi-location.sh",
        "return-type": "json",
        "interval": 5,

// Display
        "format": "{}",
        "tooltip": true,

// NM GUI editor
        "on-click": "nm-connection-editor",

// Right-Click: open TUI with kitty
        "on-click-right": "kitty -e nmtui",

// Scroll toggles Wi-Fi radio
        "on-scroll-up": "nmcli radio wifi on",
        "on-scroll-down": "nmcli radio wifi off"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Connected to {device_alias}",
        "on-click": "blueman-manager",
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% ",
        "format-bluetooth-muted": "󰝟 ",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}

